#!/bin/bash
# freitask: faz exec do binário Rust, instalado pelo setup.sh com
# `cargo install --path ~/dev/freitask.nvim/crates/freitask`. A regra mora
# no binário; aqui não há lógica nenhuma.
#
# O binário é procurado pelo caminho do cargo, não pelo PATH: este shim também
# se chama `freitask` e, com ~/.local/bin antes de ~/.cargo/bin, acharia a si
# mesmo.
set -euo pipefail
BIN="${CARGO_HOME:-$HOME/.cargo}/bin/freitask"
if [[ ! -x "$BIN" ]]; then
  echo "freitask: binário não instalado em $BIN" >&2
  echo "  -> ~/dotfiles/setup.sh" >&2
  exit 2
fi
exec "$BIN" "$@"
