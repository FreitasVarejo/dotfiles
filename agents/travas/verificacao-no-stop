#!/usr/bin/env python3
"""Trava da verificação (ADRs 0030 e 0037): o que esta sessão mudou só encerra verificado.

  verificacao-no-stop marca          PreToolUse: Edit/Write anotam o caminho na lista
                                     da sessão; Bash fotografa o que está sujo antes.
  verificacao-no-stop pos-bash       PostToolUse(Failure) do Bash: o que ficou sujo
                                     durante o comando, ou já estava sujo e mudou,
                                     entra na lista.
  verificacao-no-stop carimba <raiz> A skill `verificar`, com os portões verdes, grava
                                     a impressão de cada arquivo sujo como verificada.
  verificacao-no-stop                Stop: caminho da lista ainda sujo e com impressão
                                     diferente da carimbada bloqueia o fim do turno.

Só vale para repo que optou: o que tem docs/agents/verificacao.md. A lista é por
sessão e por repo, e o que outra sessão suja no mesmo repo não entra nela. O que
já estava sujo antes da sessão só entra se ela tocar o arquivo, e aí ela responde
por ele inteiro. O Bash conta no repo do cwd e nos que a sessão já tocou.

O carimbo não tem dono: a `verificar` lê o diff inteiro e roda os portões na
árvore toda, então cobre todo arquivo sujo daquele momento. Impressão é o hash do
conteúdo; arquivo grande é tamanho e mtime (há repo com mídia não rastreada).
Mudança comitada sai da trava e da lista: a rede para ela é o pre-commit do repo.
Bloqueia uma vez: com `stop_hook_active`, o turno já é a continuação pedida.
"""

import fcntl
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile

ADAPTER = os.path.join("docs", "agents", "verificacao.md")
FILE_TOOLS = {"Edit", "Write", "NotebookEdit", "MultiEdit"}
# Segunda linha da lista e primeira do carimbo. Arquivo sem ela é do formato da
# linha de base (antes da ADR 0037) e vale como vazio.
LIST_TAG = "# toques v2"
STAMP_TAG = "# carimbo v2"
BIG = 8 << 20


def git(root, *args):
    return subprocess.run(["git", "-C", root, *args], capture_output=True)


def repo_root(path):
    """Raiz do repo que contém `path` (que pode ainda não existir), ou None."""
    path = os.path.realpath(os.path.expanduser(path))
    while path and not os.path.isdir(path):
        path = os.path.dirname(path)
    if not path:
        return None
    r = git(path, "rev-parse", "--show-toplevel")
    return r.stdout.decode().strip() if r.returncode == 0 else None


def opted_in(root):
    return bool(root) and os.path.isfile(os.path.join(root, ADAPTER))


def dirty(root):
    """Caminhos, relativos à raiz, que diferem do HEAD, rastreados ou não; None se o git falha.

    Roda duas vezes por Bash: `--no-optional-locks` impede o status de regravar o
    índice e disputar o index.lock com o `git add` de outra sessão.
    """
    r = git(root, "--no-optional-locks", "status", "--porcelain=v1", "-z", "--no-renames",
            "--untracked-files=all")
    if r.returncode != 0:
        return None
    return {os.fsdecode(e[3:]) for e in r.stdout.split(b"\0") if len(e) > 3}


def fingerprint(root, rel):
    full = os.path.join(root, rel)
    try:
        st = os.lstat(full)
    except OSError:
        return "-"
    if stat.S_ISLNK(st.st_mode):
        return "l:" + os.readlink(full)
    if not stat.S_ISREG(st.st_mode) or st.st_size > BIG:
        return "s:%d:%d" % (st.st_size, st.st_mtime_ns)
    h = hashlib.sha256()
    with open(full, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def stamp_path(root):
    gd = git(root, "rev-parse", "--absolute-git-dir").stdout.decode().strip()
    return os.path.join(gd, "verificar.carimbo")


def read_stamp(root):
    lines = (read(stamp_path(root)) or "").split("\n")
    if lines[0] != STAMP_TAG:
        return {}
    return dict(l.rsplit("\t", 1) for l in lines[1:] if "\t" in l)


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    return os.path.join(base, "claude-travas")


def safe(value):
    return re.sub(r"[^A-Za-z0-9_-]", "_", value)


def list_path(session_id, root):
    # O prefixo `verif-` e a raiz na primeira linha são o que a skill `fechar` lê.
    key = hashlib.sha1(root.encode()).hexdigest()[:16]
    return os.path.join(runtime_dir(), "verif-%s-%s" % (safe(session_id), key))


def session_files(prefix, session_id):
    start = "%s-%s-" % (prefix, safe(session_id))
    try:
        names = os.listdir(runtime_dir())
    except OSError:
        return []
    return [os.path.join(runtime_dir(), n) for n in sorted(names) if n.startswith(start)]


def snapshot_path(session_id, tool_use_id):
    return os.path.join(runtime_dir(), "prebash-%s-%s" % (safe(session_id), safe(tool_use_id or "x")))


def read(path):
    try:
        # surrogateescape: a lista guarda nome de arquivo, que pode não ser UTF-8.
        with open(path, encoding="utf-8", errors="surrogateescape") as fh:
            return fh.read().strip()
    except OSError:
        return None


def read_list(path):
    lines = (read(path) or "").split("\n")
    if len(lines) < 2 or lines[1] != LIST_TAG:
        return lines[0], set()
    return lines[0], {l for l in lines[2:] if l}


def write_list(path, root, rels):
    tmp = os.path.join(os.path.dirname(path), "tmp-" + os.path.basename(path))
    with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as fh:
        fh.write("\n".join([root, LIST_TAG] + sorted(rels)) + "\n")
    os.replace(tmp, path)


class session_lock:
    """Chamadas paralelas da mesma sessão mexem na mesma lista."""

    def __init__(self, session_id):
        self.path = os.path.join(runtime_dir(), "lock-%s" % safe(session_id))

    def __enter__(self):
        os.makedirs(runtime_dir(), exist_ok=True)
        self.fh = open(self.path, "a")
        fcntl.flock(self.fh, fcntl.LOCK_EX)

    def __exit__(self, *exc):
        self.fh.close()


def add(session_id, root, rels):
    rels = {r for r in rels if r and r not in (".", os.pardir) and not r.startswith(os.pardir + os.sep)}
    if not rels:
        return
    path = list_path(session_id, root)
    with session_lock(session_id):
        lines = (read(path) or "").split("\n")
        have = read_list(path)[1] if lines[:2] == [root, LIST_TAG] else set()
        if not rels <= have or lines[:2] != [root, LIST_TAG]:
            write_list(path, root, have | rels)


def mark(data):
    tool, tool_input = data.get("tool_name"), data.get("tool_input") or {}
    if tool == "Bash":
        return snapshot(data)
    if tool not in FILE_TOOLS:
        return
    target = tool_input.get("file_path") or tool_input.get("notebook_path")
    root = repo_root(target) if target else None
    if opted_in(root):
        add(data["session_id"], root, {os.path.relpath(os.path.realpath(os.path.expanduser(target)), root)})


def snapshot(data):
    roots = set()
    cwd_root = repo_root(data["cwd"]) if data.get("cwd") else None
    if opted_in(cwd_root):
        roots.add(cwd_root)
    for path in session_files("verif", data["session_id"]):
        root = read_list(path)[0]
        if opted_in(root):
            roots.add(root)
    sujos = {}
    for root in roots:
        now = dirty(root)
        if now is not None:
            sujos[root] = {rel: mtime(root, rel) for rel in now}
    if not sujos:
        return
    os.makedirs(runtime_dir(), exist_ok=True)
    with open(snapshot_path(data["session_id"], data.get("tool_use_id")), "w") as fh:
        json.dump({"sujos": sujos}, fh)


def mtime(root, rel):
    """mtime do caminho, ou -1 se ele não existe (apagado, ou a origem de um mv)."""
    try:
        return os.lstat(os.path.join(root, rel)).st_mtime_ns
    except OSError:
        return -1


def settle(session_id, path):
    """Atribui à sessão o que um Bash mudou, a partir da foto tirada antes dele."""
    try:
        with open(path) as fh:
            snap = json.load(fh)
        os.remove(path)
    except (OSError, ValueError):
        return
    for root, before in snap["sujos"].items():
        now = dirty(root)
        if now is None:
            continue
        # Sujou durante o comando, ou já estava sujo e mudou de mtime ou de
        # existência: apagar e mover não deixam mtime, mas deixam de existir.
        touched = {rel for rel in now if rel not in before or mtime(root, rel) != before[rel]}
        add(session_id, root, touched)


def pos_bash(data):
    # Em segundo plano, o PostToolUse chega quando o comando é lançado, não quando
    # termina: a foto fica para o Stop, que a assenta no fim do turno.
    if (data.get("tool_input") or {}).get("run_in_background"):
        return
    settle(data["session_id"], snapshot_path(data["session_id"], data.get("tool_use_id")))


def carimba(root):
    root = repo_root(root)
    if root is None:
        sys.exit("verificacao-no-stop: não é um repo git")
    now = dirty(root) or set()
    lines = ["%s\t%s" % (rel, fingerprint(root, rel)) for rel in sorted(now)]
    with open(stamp_path(root), "w", encoding="utf-8", errors="surrogateescape") as fh:
        fh.write("\n".join([STAMP_TAG] + lines) + "\n")


def stop(data):
    session_id = data["session_id"]
    # Bash em segundo plano, interrompido ou negado antes de rodar deixa a foto para
    # trás. Assentá-la aqui cobra desta sessão o que sujou até agora: erra para cobrar.
    for path in session_files("prebash", session_id):
        settle(session_id, path)
    pending = []
    for path in session_files("verif", session_id):
        root, rels = read_list(path)
        if not rels or not opted_in(root):
            continue
        now = dirty(root)
        if now is None:
            continue
        still = rels & now
        if still != rels:
            # Comitado ou desfeito: sai da lista, e quem sujar o arquivo depois não
            # cai na conta desta sessão.
            with session_lock(session_id):
                write_list(path, root, still | (read_list(path)[1] - rels))
        stamp = read_stamp(root)
        if any(stamp.get(rel) != fingerprint(root, rel) for rel in still):
            pending.append(root)
    if not pending or data.get("stop_hook_active"):
        return
    reason = (
        "Esta sessão mudou código sem verificação em: " + ", ".join(pending) + ". "
        "Antes de encerrar, rode a skill `verificar` (/verificar): ela roda os portões "
        "de docs/agents/verificacao.md, confere o diff e grava o carimbo."
    )
    json.dump({"decision": "block", "reason": reason}, sys.stdout, ensure_ascii=False)


def main():
    if sys.argv[1:2] == ["carimba"] and len(sys.argv) == 3:
        return carimba(sys.argv[2])
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    if not data.get("session_id"):
        return
    if sys.argv[1:] == ["marca"]:
        mark(data)
    elif sys.argv[1:] == ["pos-bash"]:
        pos_bash(data)
    else:
        stop(data)


if __name__ == "__main__":
    main()
