#!/usr/bin/env python3
"""Trava PreToolUse (Bash): uso de chave de API guardada em ~/.config/claude/ pede aprovação do dono.

As chaves de API dos serviços do pi01 ficam em `~/.config/claude/<serviço>-api-key`. A trava
devolve `permissionDecision: "ask"` (o agente mostra o comando ao dono, que aprova ou nega cada
uso) em dois casos, cada um com o seu motivo; se os dois valem, os motivos saem juntos, num
só JSON:

- o comando cita `.config/claude` por `~`, `$HOME`, `${HOME}` ou `/home/<usuário>`;
- o comando roda `chaves`, o script do pi01 que lê e grava essas chaves sem citar o caminho:
  a palavra de comando de um comando simples (depois dos prefixos `sudo`, `env`…) é `chaves`, nome
  nu ou com caminho (`~/.local/bin/chaves`), com ou sem argumento. `chaves` como argumento ou
  parte de caminho (`ls chaves/`, `cd ~/docker/system/chaves && ./teste.sh`) não pergunta.

Não é muro técnico (o agente lê um `.env` do pi01 do mesmo jeito): é consentimento por uso.

Os dois se procuram no texto inteiro e descem no que roda em outro shell: o comando remoto do
`ssh` (o que vem depois do host) e o argumento de `bash -c` / `sh -c`. A citação também se procura
em cada palavra já sem aspas, e aspas sem fechar não escondem a citação: o texto inteiro vale mesmo
quando o shell recusaria o comando. Quebra de comandos e prefixos vêm da `tasks-so-pelo-freitask`.

Entrada: o JSON do hook no stdin. Saída: nada (deixa seguir) ou o JSON de `permissionDecision: ask`.
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import sys

MAX_DEPTH = 4
MAX_FILES = 5
SHELLS = {"bash", "sh", "zsh", "dash", "ksh"}
# Opções do ssh que levam argumento: o host é a primeira palavra que não é opção nem argumento de opção.
SSH_WITH_ARG = set("bcDEeFIiJLlmOopQRSWw")

HOME = r"(?:(?<![\w.-])~|\$HOME|\$\{HOME\}|(?<![\w.-])/home/[^/\s\"'`$()]+)"
CITATION = re.compile(HOME + r"/\.config/claude(?![\w.-])(?:/[^\s\"'`;&|<>()$]*)?")


def sibling(name):
    """O módulo de uma trava vizinha (o script não tem `.py`); sem bytecode ao lado dele."""
    sys.dont_write_bytecode = True
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), name)
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


shell = sibling("tasks-so-pelo-freitask")


def ssh_remote(args):
    """O comando remoto de `ssh [opções] host comando…` como um texto só, ou None."""
    i = 0
    while i < len(args):
        word = args[i]
        if word == "--":
            i += 1
            break
        if not word.startswith("-") or len(word) == 1:
            break
        i += 2 if len(word) == 2 and word[1] in SSH_WITH_ARG else 1
    rest = args[i + 1:]
    return " ".join(rest) if rest else None


def shell_script(args):
    """O texto que `bash -c <texto>` roda, ou None."""
    for i, word in enumerate(args):
        if word.startswith("-") and not word.startswith("--"):
            if "c" in word[1:]:
                return args[i + 1] if i + 1 < len(args) else None
        elif not word.startswith("-"):
            return None
    return None


def inner_script(words):
    words = shell.strip_prefixes(words)
    if not words:
        return None
    name = os.path.basename(words[0])
    if name == "ssh":
        return ssh_remote(words[1:])
    if name in SHELLS:
        return shell_script(words[1:])
    return None


def runs_chaves(words):
    """A palavra de comando, depois dos prefixos, é `chaves` (nome nu ou com caminho)."""
    words = shell.strip_prefixes(words)
    return bool(words) and os.path.basename(words[0]) == "chaves"


def scan(text, found, ran, depth=0):
    """Acrescenta a `found` cada arquivo de ~/.config/claude citado em `text` e a `ran` um item
    se `text` roda `chaves`, descendo nos shells de dentro."""
    found.extend(m.group(0) for m in CITATION.finditer(text))
    if depth >= MAX_DEPTH:
        return
    # A crase abre um comando como o `$(`: vira separador para a palavra de comando aparecer.
    for words in shell.simple_commands(text.replace("`", " ; ")):
        for word in words:
            found.extend(m.group(0) for m in CITATION.finditer(word))
        if runs_chaves(words):
            ran.append("chaves")
        inner = inner_script(words)
        if inner:
            scan(inner, found, ran, depth + 1)


def citation_reason(files):
    unique = list(dict.fromkeys(files))
    shown = ", ".join(unique[:MAX_FILES]) + (" e outros" if len(unique) > MAX_FILES else "")
    return (
        "Uso de chave de API: o comando cita %s, onde ficam as chaves de API do dono. "
        "Aprove só se for o uso que o dono pediu." % shown
    )


CHAVES_REASON = (
    "Uso de chave de API: o comando roda `chaves`, que lê e grava as chaves de API do dono. "
    "Aprove só se for o uso que o dono pediu."
)


def reason(files, ran):
    return " ".join(([citation_reason(files)] if files else []) + ([CHAVES_REASON] if ran else []))


def main():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    if not isinstance(data, dict) or data.get("tool_name") != "Bash":
        return
    tool_input = data.get("tool_input")
    command = tool_input.get("command") if isinstance(tool_input, dict) else None
    if not isinstance(command, str):
        return
    found, ran = [], []
    scan(command, found, ran)
    if found or ran:
        json.dump(
            {
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "ask",
                    "permissionDecisionReason": reason(found, ran),
                }
            },
            sys.stdout,
            ensure_ascii=False,
        )


if __name__ == "__main__":
    main()
