{
  "PreToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        { "type": "command", "command": "'${TRAVAS_DIR}/tasks-so-pelo-freitask'", "timeout": 10 }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Edit|Write|NotebookEdit|Bash",
      "hooks": [
        { "type": "command", "command": "'${TRAVAS_DIR}/doctor-no-stop' marca", "timeout": 10 }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        { "type": "command", "command": "'${TRAVAS_DIR}/doctor-no-stop'", "timeout": 60 }
      ]
    }
  ]
}
