#!/usr/bin/env python3
"""Fatos do disco para o fim de uma sessão (skill `fechar`, ADRs 0031 e 0039).

  pendencias [--sessao <id>] [--repo <dir>]... [--horas <n>] [--sem-rede] [--plano]

Nada aqui é lista fixa (ADR 0017):
- o que é desta sessão: os repos das listas `verif-<sessão>-*` (a raiz na
  primeira linha), o cwd e os de --repo; o que ela escreveu no vault, de
  `toques-vault-<sessão>`. Quem grava os dois são as travas `verificacao-no-stop`
  e `doctor-no-stop`, em $XDG_RUNTIME_DIR/claude-travas/;
- o que é de outra sessão sai resumido; item enterrado e sync-conflict, sempre;
- outras máquinas, os projetos que um contrato alimenta e o clone principal de
  um worktree: o `vault-vinculos` (as regras estão no `vault-vinculos --help`);
- o "Decidido" e o "Adiado" de cada projeto tocado, pelo coletor da
  current-project-state;
- em `## arquivar sem perguntar`, a task em `question` de projeto tocado, de
  qualquer sessão, sem `- [ ]` aberto, cuja branch `<id>` tem PR mergeada e
  nenhuma aberta nos repos do projeto. Repo que o gh não respondeu tira a task
  da lista, com a linha do porquê.

Só lê. A exceção é o `git fetch`, que atualiza as refs remotas para "atrás do
origin" não mentir; --sem-rede pula fetch, GitHub e ssh.

--plano acrescenta, no fim da saída (que não muda), a seção `## plano`: os
comandos que a saída já deixa ver, mais o das redes do docker, um por linha,
`P<n>. <comando> — <motivo>`. O script só os imprime; quem roda é a skill, e só
o que o dono aprovar. O conjunto é fechado e nunca força:
- push de cada repo e worktree desta sessão que está à frente do upstream, sem
  estar atrás, e cujo upstream tem o nome da própria branch: `git push <remote>
  <branch>`. A reserva é o OK do dono, não o git, que aceitaria o commit de outra
  sessão: o motivo diz quantos commits vão e quais. A branch padrão de repo com
  `.github/workflows/` não entra (o merge ali é por PR), nem a branch sem
  upstream, divergida, de upstream com outro nome ou vista com --sem-rede;
- o clone principal na branch padrão, atrás do upstream (o origin/HEAD), sem
  commit à frente e sem arquivo rastreado modificado: `merge --ff-only
  <upstream>`. Com --sem-rede também, até onde o último fetch viu;
- worktree local que pode sair, está limpa e não está trancada, desta sessão ou
  de outra (o motivo diz de qual): `worktree remove` e `branch -d` da branch
  dela, num item só. O motivo nomeia cada arquivo que o git ignora ali, que o
  remove apaga junto, e resume as pastas ignoradas;
- branch local fora de worktree que pode sair: `branch -d`. Este item e o de
  cima, quando o `branch -d` só aceitaria depois do fast-forward, dependem dele;
- as redes do docker sem container nenhum, nem parado, fora `bridge`, `host` e
  `none`: `docker network rm <nomes>`, num item só;
- o ~/dotfiles de outro host, limpo e sem commit à frente, que está atrás do
  origin ou ficará atrás depois de um item de push (o pull então depende do
  push): `pull --ff-only` por ssh e, se o diff pede (`setup_reason`), o
  `./setup.sh` num item à parte;
- o que podia sair e não cabe num item (sujo, trancado, `branch -d` que
  recusaria, push que o git recusaria, fast-forward com arquivo modificado, host
  à frente, ssh mudo, docker mudo, --sem-rede) sai depois dos itens, em `- fora
  do plano: ...`. A worktree desta sessão vai por último.
"""

import argparse
import fnmatch
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

VAULT = os.path.realpath(os.path.expanduser(os.environ.get("FECHAR_VAULT", "~/ObsidianVault")))
OPEN_ITEM = re.compile(r"^\s*- \[ \]", re.M)
TASK_PATH = re.compile(r"^projects/([^/]+)/tasks/(?:archived/[^/]+/)?([^/]+)\.md$")
COLETOR = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))),
                       "current-project-state", "scripts", "coletar-estado.sh")
HOME = os.path.expanduser("~")


def run(args, cwd=None, timeout=30):
    try:
        # surrogateescape: caminho de worktree ou nome de branch que não é UTF-8.
        r = subprocess.run(args, cwd=cwd, capture_output=True, text=True, errors="surrogateescape",
                           timeout=timeout)
        # Só o fim: o começo da primeira linha do `status --porcelain` é coluna.
        return r.returncode, r.stdout.rstrip()
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""


def git(root, *args, timeout=30):
    return run(["git", "-C", root, *args], timeout=timeout)


def tilde(path):
    return "~" + path[len(HOME):] if path == HOME or path.startswith(HOME + os.sep) else path


def runtime_file(name):
    import tempfile

    base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    return os.path.join(base, "claude-travas", name)


def safe(sid):
    return re.sub(r"[^A-Za-z0-9_-]", "_", sid)


def session_lists(sid):
    """Raiz → caminhos sujos que a trava da verificação atribui a esta sessão.

    Comitado sai da lista, e repo que não optou guarda só a raiz: ali a lista
    não diz de quem é o arquivo sujo (`touched_files` devolve None).
    """
    if not sid:
        return {}
    lists = {}
    for path in glob.glob(runtime_file("verif-%s-*" % safe(sid))):
        with open(path, encoding="utf-8", errors="surrogateescape") as fh:
            lines = fh.read().split("\n")
        lists[lines[0].strip()] = {l for l in lines[2:] if l} if lines[1:2] == ["# toques v2"] else set()
    return lists


def touched_files(root, lists, sid):
    if not sid or not os.path.isfile(os.path.join(root, "docs", "agents", "verificacao.md")):
        return None
    return lists.get(root, set())


def dirty_entries(root):
    """`XY caminho` de cada arquivo sujo, como a trava da verificação os vê.

    Com -z o caminho vem cru (sem aspas nem escape octal), e com
    --untracked-files=all a pasta nova sai arquivo por arquivo, como na lista.
    Bytes e `fsdecode`, como a trava: nome que não é UTF-8 não derruba o script.
    `--no-optional-locks` não disputa o index.lock com o `git add` de outra sessão.
    """
    try:
        r = subprocess.run(["git", "-C", root, "--no-optional-locks", "status", "--porcelain=v1", "-z",
                            "--no-renames", "--untracked-files=all"], capture_output=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return []
    return [os.fsdecode(e) for e in r.stdout.split(b"\0") if len(e) > 3]


def vault_toques(sid):
    """Linhas `arquivo <rel>` e `task <id>` do que a sessão escreveu; None sem sessão."""
    if not sid:
        return None
    try:
        with open(runtime_file("toques-vault-" + safe(sid)), encoding="utf-8") as fh:
            return list(dict.fromkeys(l.strip() for l in fh if l.strip()))
    except OSError:
        return []


def repo_root(path):
    rc, out = git(path, "rev-parse", "--show-toplevel")
    return out if rc == 0 and out else None


def vinculos(*args, cols=1):
    """Linhas do `vault-vinculos`, cada uma com `cols` colunas; None quando ele falta ou falha."""
    rc, out = run(["vault-vinculos", *args])
    if rc != 0:
        return None
    # O run tira o fim da saída, e com ele o tab de uma última coluna vazia.
    return [(l.split("\t") + [""] * cols)[:cols] for l in out.split("\n") if l]


def falta_vinculos(o_que):
    return "o vault-vinculos não respondeu (o ~/dotfiles/setup.sh o põe no PATH), não sei %s" % o_que


def sem_vinculos(o_que):
    """A linha que diz o que ficou sem resposta quando o `vault-vinculos` falta ou falha: sem ela, a falta parece "nada"."""
    return [] if vinculos("projetos") is not None else [falta_vinculos(o_que)]


def main_clone(root):
    """O clone principal de `root`; None quando o `vault-vinculos` não respondeu."""
    rows = vinculos("repo", root, cols=2)
    return None if rows is None else rows[0][0] if rows else root


def slug(root):
    _, url = git(root, "remote", "get-url", "origin")
    m = re.match(r"^(?:git@github\.com:|https://github\.com/)([^/]+/[^/]+?)(?:\.git)?$", url)
    return m.group(1) if m else ""


def default_ref(root):
    rc, out = git(root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    return out if rc == 0 else ""


def merged(root, ref, into):
    return bool(into) and git(root, "merge-base", "--is-ancestor", ref, into)[0] == 0


def committed(root, branch):
    """A branch já recebeu commit próprio? Recém-criada também é ancestral da base."""
    _, log = git(root, "reflog", "show", "--format=%gs", "refs/heads/" + branch)
    return any(l.startswith(("commit", "merge", "cherry-pick", "rebase", "pull")) for l in log.split("\n"))


def leftover(root, branch, base):
    if not merged(root, branch, base):
        return ""
    if not committed(root, branch):
        return " — sem commit próprio (recém-criada?)"
    return " — já está em %s: pode sair" % base


def worktrees(main):
    """(caminho, branch ou None) de cada worktree além do clone principal."""
    _, out = git(main, "worktree", "list", "--porcelain")
    found = []
    for block in out.split("\n\n"):
        path = re.search(r"^worktree (.+)$", block, re.M)
        branch = re.search(r"^branch refs/heads/(.+)$", block, re.M)
        if path and path.group(1) != main:
            found.append((path.group(1), branch.group(1) if branch else None))
    return found


def plural(n, one, many):
    return "%d %s" % (n, one if n == 1 else many)


def report_repo(main, roots, ours, net):
    """`ours`: raiz → caminhos da sessão, ou None quando a lista não sabe dizer."""
    lines = ["### %s" % tilde(main)]
    if net:
        git(main, "fetch", "--quiet", "--prune", timeout=40)
    base = default_ref(main)
    mine = set()
    for root in roots:
        _, branch = git(root, "rev-parse", "--abbrev-ref", "HEAD")
        mine.add(branch)
        dirty = dirty_entries(root)
        rc, counts = git(root, "rev-list", "--left-right", "--count", "@{upstream}...HEAD")
        if rc == 0:
            behind, ahead = counts.split()
            sync = "atrás %s, à frente %s do upstream" % (behind, ahead)
        else:
            sync = "sem upstream"
        where = "clone principal" if root == main else "worktree %s" % tilde(root)
        tag = leftover(main, branch, base) if root != main and branch != "HEAD" else ""
        if ours[root] is None:
            show, rest = dirty, 0
            lines.append("%s [%s] · %s · %d arquivo(s) sem commit%s" % (where, branch, sync, len(dirty), tag))
        else:
            show = [l for l in dirty if l[3:] in ours[root]]
            rest = len(dirty) - len(show)
            lines.append("%s [%s] · %s · %d arquivo(s) sem commit desta sessão%s" % (
                where, branch, sync, len(show), tag))
        lines += ["  %s" % l for l in show[:8]] + (["  …"] if len(show) > 8 else [])
        if rest:
            lines.append("  +%d sem commit de outras sessões" % rest)

    wts = worktrees(main)
    others = [(p, b) for p, b in wts if p not in roots]
    gone = sum(1 for _, b in others if b and leftover(main, b, base).endswith("pode sair"))
    if others:
        lines.append("+%s de outras sessões%s" % (plural(len(others), "worktree", "worktrees"),
                     ", %d já mergeado(s): pode sair" % gone if gone else ""))
    checked = {b for _, b in wts if b}
    _, heads = git(main, "rev-parse", "--abbrev-ref", "HEAD")
    _, refs = git(main, "for-each-ref", "--format=%(refname:short)", "refs/heads")
    loose = [b for b in refs.split("\n") if b and b not in mine and b not in checked and b != heads]
    gone = sum(1 for b in loose if leftover(main, b, base).endswith("pode sair"))
    if loose:
        lines.append("+%s fora de worktree%s" % (plural(len(loose), "branch local", "branches locais"),
                     ", %d já mergeada(s): pode sair" % gone if gone else ""))

    s = slug(main)
    if net and s:
        rc, out = run(["gh", "pr", "list", "--repo", s, "--state", "open", "--limit", "30",
                       "--json", "number,title,headRefName,isDraft"], timeout=25)
        if rc != 0:
            lines.append("PRs: não consultei (gh falhou)")
        else:
            prs = json.loads(out or "[]")
            for pr in prs:
                if pr["headRefName"] in mine:
                    lines.append("PR aberto #%d [%s]%s %s" % (pr["number"], pr["headRefName"],
                                 " (rascunho)" if pr["isDraft"] else "", pr["title"]))
            rest = sum(1 for pr in prs if pr["headRefName"] not in mine)
            if rest:
                lines.append("+%s de outras branches" % plural(rest, "PR aberto", "PRs abertos"))
        rc, out = run(["gh", "pr", "list", "--repo", s, "--state", "merged", "--limit", "10",
                       "--json", "number,title,mergedAt,headRefName"], timeout=25)
        if rc == 0:
            since = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(time.time() - 24 * 3600))
            recent = [pr for pr in json.loads(out or "[]") if pr["mergedAt"] >= since]
            for pr in recent:
                if pr["headRefName"] in mine:
                    lines.append("PR mergeado nas últimas 24 h #%d %s" % (pr["number"], pr["title"]))
            rest = sum(1 for pr in recent if pr["headRefName"] not in mine)
            if rest:
                lines.append("+%s nas últimas 24 h, de outras branches" % plural(rest, "PR mergeado", "PRs mergeados"))
    return lines, s


def other_hosts():
    """Os aliases de ssh de cada outra máquina, em ordem, e o primeiro a nomeia; None sem resposta do `vault-vinculos`."""
    rows = vinculos("hosts", cols=3)
    return None if rows is None else [ssh.split() for _, esta, ssh in rows if esta == "0" and ssh.split()]


# Autocontido de propósito: roda com os dotfiles do outro host, que podem estar
# atrasados, e é esse atraso que ele mede. As raízes são as do vault-vinculos, e
# o ~/dotfiles/vault/tests/vault-vinculos.sh confere que continuam sendo.
REMOTE = r"""
for d in ~/dotfiles ~/dev/* ~/projects/*; do
  [ -d "$d/.git" ] || [ -f "$d/.git" ] || continue
  # Worktree vinculado sai pelo clone principal, na lista de baixo.
  [ "$(git -C "$d" rev-parse --absolute-git-dir 2>/dev/null)" = \
    "$(git -C "$d" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ] || continue
  u=$(git -C "$d" remote get-url origin 2>/dev/null) || continue
  case "$u" in *"$1"|*"$1.git") ;; *) continue ;; esac
  git -C "$d" fetch -q 2>/dev/null
  # Depois do sujo, só para o --plano: atrás/à frente do upstream, os shas do HEAD
  # e do upstream (o diff sai do clone local), o $HOME, para achar ~/dotfiles, e o
  # nome do upstream, para casar com a branch que um push publica.
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$d" "$(git -C "$d" status -sb | head -1)" \
    "$(git -C "$d" status --porcelain | wc -l)" \
    "$(git -C "$d" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null | tr '\t' ' ')" \
    "$(git -C "$d" rev-parse HEAD 2>/dev/null)" "$(git -C "$d" rev-parse '@{upstream}' 2>/dev/null)" "$HOME" \
    "$(git -C "$d" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)"
  # Os worktrees além do principal, com o mesmo "pode sair" do lado local (leftover).
  base=$(git -C "$d" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
  git -C "$d" worktree list --porcelain | awk '
    /^worktree /{n++; p=substr($0, 10)}
    /^branch refs\/heads\//{if (n > 1) print p "\t" substr($0, 19)}
    /^detached/{if (n > 1) print p "\t(detached)"}' |
  while IFS="$(printf '\t')" read -r p b; do
    tag=""
    if [ "$b" != "(detached)" ] && [ -n "$base" ] && git -C "$d" merge-base --is-ancestor "$b" "$base" 2>/dev/null; then
      if git -C "$d" reflog show --format=%gs "refs/heads/$b" 2>/dev/null | grep -qE '^(commit|merge|cherry-pick|rebase|pull)'; then
        tag=" — já está em $base: pode sair"
      else
        tag=" — sem commit próprio (recém-criada?)"
      fi
    fi
    printf 'wt\t%s\t%s\t%s\n' "$p" "$b" "$tag"
  done
done
"""


def report_hosts(slugs, net, facts=None):
    """Linhas da seção; `facts`, se vier, recebe um dict por clone achado e por host mudo (para o --plano)."""
    facts = [] if facts is None else facts
    lines = []
    if not slugs:
        return ["nenhum repo com remoto no GitHub para comparar"]
    hosts = other_hosts()
    if hosts is None:
        return [falta_vinculos("quais são as outras máquinas")]
    for ssh in hosts:
        alias = ssh[0]
        if not net:
            lines.append("%s: não consultei (--sem-rede)" % alias)
            continue
        found = False
        for target in ssh:
            got = []
            ok = True
            for s in slugs:
                try:
                    p = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", target,
                                        "bash", "-s", "--", s], input=REMOTE, capture_output=True,
                                       text=True, timeout=60)
                except subprocess.TimeoutExpired:
                    ok = False
                    break
                if p.returncode == 255:
                    ok = False
                    break
                got += [(s, l) for l in p.stdout.split("\n") if l]
            if not ok:
                continue
            found = True
            if not got:
                lines.append("%s: nenhum clone dos repos tocados" % target)
            for s, l in got:
                if l.startswith("wt\t"):
                    _, path, branch, tag = (l.split("\t") + [""])[:4]
                    lines.append("%s:%s  worktree [%s]%s" % (target, path, branch, tag))
                    continue
                path, status, dirty, counts, head, up, home, upname = (l.split("\t") + [""] * 8)[:8]
                lines.append("%s:%s  %s  · %s arquivo(s) sem commit" % (target, path, status, dirty.strip()))
                n = counts.split()
                facts.append({"alias": alias, "alvo": target, "slug": s, "path": path, "home": home,
                              "behind": int(n[0]) if len(n) == 2 and n[0].isdigit() else None,
                              "ahead": int(n[1]) if len(n) == 2 and n[1].isdigit() else None,
                              "dirty": int(dirty) if dirty.strip().isdigit() else None,
                              "head": head, "up": up, "upname": upname.strip()})
            break
        if not found:
            lines.append("%s: não consultei (ssh não respondeu em %s)" % (alias, " nem ".join(ssh)))
            facts.append({"alias": alias, "mudo": True})
    return lines or ["nenhuma outra máquina em hosts/"]


# --plano: só texto. Nada abaixo roda comando; o conjunto é fechado (push, fast-forward do clone
# principal, worktree/branch que pode sair, redes vazias do docker, pull e setup do ~/dotfiles de outro host).


def item(cmd, why, last=False, dep=None, push=None, ff=None):
    """Um item do plano. `last`: vai por último (a worktree da sessão). `dep`: item de que este depende;
    o NUL no `why` vira o número dele na hora de numerar. `push`: o que um item de push publica
    (`main`, `upstream`, `head`, `ahead`), de onde o host prevê que ficará atrás. `ff`: o upstream a que um
    item de fast-forward leva o clone principal, contra o qual o `branch -d` passa a conferir."""
    return {"cmd": cmd, "why": why, "last": last, "dep": dep, "push": push, "ff": ff}


def shpath(path):
    """Caminho para colar no shell: sob o HOME vai com `~/` na frente (o bash expande), o resto entre aspas."""
    if path == HOME:
        return "~"
    if path.startswith(HOME + os.sep):
        return "~/" + shlex.quote(path[len(HOME) + 1:])
    return shlex.quote(path)


def is_clean(root):
    """Sem arquivo modificado nem novo? O git falhar não conta como limpo."""
    rc, out = git(root, "--no-optional-locks", "status", "--porcelain", "--untracked-files=all")
    return rc == 0 and not out


def is_clean_tracked(root):
    """Sem arquivo rastreado modificado? Arquivo novo não conta: o merge recusa sobrescrevê-lo."""
    rc, out = git(root, "--no-optional-locks", "status", "--porcelain", "--untracked-files=no")
    return rc == 0 and not out


def ignored(root):
    """(arquivos, pastas) que o git ignora na worktree: o `worktree remove` sem --force apaga junto, sem recusar.

    O modo `matching` dá pelo nome o arquivo ignorado numa pasta que não é ignorada, mesmo que tudo nela seja (o
    `.impeccable/hook.cache.json`); o modo padrão o esconderia atrás de `.impeccable/`. Com -z o caminho vem cru."""
    _, out = git(root, "--no-optional-locks", "status", "--porcelain", "-z", "--ignored=matching",
                 "--untracked-files=normal")
    found = [e[3:] for e in out.split("\0") if e.startswith("!! ")]
    return [f for f in found if not f.endswith("/")], [f for f in found if f.endswith("/")]


def apaga_junto(root, limit=4):
    """O trecho do motivo com o que o remove apaga junto: todo arquivo ignorado avulso pelo nome, as pastas resumidas."""
    arquivos, pastas = ignored(root)
    trechos = []
    if arquivos:
        trechos.append("%s %s" % ("o arquivo ignorado" if len(arquivos) == 1 else "os arquivos ignorados",
                                  ", ".join(arquivos)))
    if pastas:
        trechos.append("%s %s" % ("a pasta ignorada" if len(pastas) == 1 else "as pastas ignoradas",
                                  ", ".join(pastas[:limit]) + (", …" if len(pastas) > limit else "")))
    return "; apaga junto %s" % "; e ".join(trechos) if trechos else ""


def locked(main):
    """Caminhos das worktrees trancadas (`git worktree lock`): o remove sem --force as recusa."""
    _, out = git(main, "worktree", "list", "--porcelain")
    return {m.group(1) for block in out.split("\n\n") if re.search(r"^locked", block, re.M)
            for m in [re.search(r"^worktree (.+)$", block, re.M)] if m}


def can_leave(main, branch, base):
    return leftover(main, branch, base).endswith("pode sair")


def deletable(main, branch, head="HEAD"):
    """O `git branch -d` aceita? Ele confere o upstream da branch e, sem upstream (ou com ele sumido), o HEAD do clone.
    `head`: onde o HEAD do clone estará, para saber se aceita depois do fast-forward."""
    rc, up = git(main, "rev-parse", "--verify", "--quiet", branch + "@{upstream}")
    return git(main, "merge-base", "--is-ancestor", "refs/heads/" + branch, up if rc == 0 else head)[0] == 0


def esteira(root):
    """O repo tem esteira de PR? Sai do disco (`.github/workflows/`), sem lista de repos (ADR 0017)."""
    return os.path.isdir(os.path.join(root, ".github", "workflows"))


def plan_pushes(main, roots, net):
    """(itens, fora) do push de cada root da sessão (clone principal ou worktree). Só fast-forward, sem `--force`.

    A reserva deste item é o OK do dono, e o git não a substitui: ele aceita qualquer fast-forward, inclusive o
    commit de outra sessão, e `upstream..HEAD` não diz de quem é cada um. Por isso o motivo lista os commits.
    """
    items, fora = [], []
    if git(main, "remote", "get-url", "origin")[0] != 0:
        return items, fora
    base = default_ref(main)
    padrao = base.split("/", 1)[-1]
    for root in dict.fromkeys(roots):
        _, branch = git(root, "rev-parse", "--abbrev-ref", "HEAD")
        if branch == "HEAD":
            continue
        where = "%s [%s]" % (tilde(root), branch)
        rc, counts = git(root, "rev-list", "--left-right", "--count", "@{upstream}...HEAD")
        if rc != 0:
            if not merged(root, "HEAD", base):
                fora.append("%s: sem upstream; não proponho o push (o `push -u` cria a branch remota, e isso é do dono)" % where)
            continue
        behind, ahead = (int(n) for n in counts.split())
        if not ahead:
            continue
        _, upstream = git(root, "rev-parse", "--abbrev-ref", "@{upstream}")
        if behind:
            fora.append("%s: %s atrás e %s à frente de %s (divergida); não proponho o push, que o git recusaria"
                        % (where, plural(behind, "commit", "commits"), plural(ahead, "commit", "commits"), upstream))
            continue
        if not net:
            fora.append("%s: %s à frente de %s, mas não consultei o remoto (--sem-rede); não proponho o push"
                        % (where, plural(ahead, "commit", "commits"), upstream))
            continue
        # Só a branch que segue a si mesma: `worktree add -b x origin/main` faz `x` seguir `origin/main`, e
        # `push origin x:main` publicaria a feature na padrão.
        _, remote = git(root, "config", "branch.%s.remote" % branch)
        _, merge = git(root, "config", "branch.%s.merge" % branch)
        if remote in ("", ".") or merge != "refs/heads/" + branch:
            fora.append("%s: o upstream é %s, de outro nome; não proponho o push (criaria ou sobrescreveria outra branch)"
                        % (where, upstream))
            continue
        if esteira(root) and (not padrao or branch == padrao):
            fora.append("%s: %s repo com esteira de PR (.github/workflows/); o merge ali é por PR, não proponho o push"
                        % (where, "é a branch padrão de um" if padrao else "sem origin/HEAD, não sei se é a padrão de um"))
            continue
        _, head = git(root, "rev-parse", "HEAD")
        _, log = git(root, "log", "--format=%h %s", "-n", "5", "@{upstream}..HEAD")
        quais = "; ".join(log.split("\n")) + ("; …" if ahead > 5 else "")
        items.append(item("git -C %s push %s %s" % (shpath(root), shlex.quote(remote), shlex.quote(branch)),
                          "[%s] tem %s à frente de %s (%s); o push publica todos, inclusive o de outra sessão"
                          % (branch, plural(ahead, "commit", "commits"), upstream, quais),
                          push={"main": main, "upstream": upstream, "head": head, "ahead": ahead}))
    return items, fora


def plan_ff(main):
    """(itens, fora) do fast-forward do clone principal: na branch padrão, só atrás do upstream e sem arquivo
    rastreado modificado. A reserva é o git: o `--ff-only` recusa o que não for fast-forward, e o merge, sobrescrever
    arquivo novo. Divergido não ganha linha: o `branch -d` que recusaria já diz "atualize o clone principal"."""
    base = default_ref(main)
    _, branch = git(main, "rev-parse", "--abbrev-ref", "HEAD")
    rc, upstream = git(main, "rev-parse", "--abbrev-ref", "@{upstream}")
    if not base or branch != base.split("/", 1)[-1] or rc != 0 or upstream != base:
        return [], []
    rc, counts = git(main, "rev-list", "--left-right", "--count", "@{upstream}...HEAD")
    behind, ahead = (int(n) for n in counts.split()) if rc == 0 else (0, 0)
    if not behind or ahead:
        return [], []
    where = "%s [%s]" % (tilde(main), branch)
    if not is_clean_tracked(main):
        return [], ["%s: %s atrás de %s, mas tem arquivo rastreado modificado; não proponho o fast-forward"
                    % (where, plural(behind, "commit", "commits"), upstream)]
    return [item("git -C %s merge --ff-only %s" % (shpath(main), shlex.quote(upstream)),
                 "o clone principal %s está %s atrás de %s, sem commit à frente nem arquivo rastreado modificado"
                 % (where, plural(behind, "commit", "commits"), upstream), ff=upstream)], []


def plan_repo(main, roots, net=True):
    """(itens, fora) do push, do fast-forward e da limpeza local de um clone; `roots` são as worktrees e clones desta
    sessão. O `branch -d` que só aceitaria depois do fast-forward vira item que depende dele."""
    items, fora = plan_pushes(main, roots, net)
    ffs, f = plan_ff(main)
    items += ffs
    fora += f
    ff = ffs[0] if ffs else None
    base = default_ref(main)
    where = tilde(main)

    def after_ff(branch):
        """(dep, motivo de fora): o item do fast-forward se o `branch -d` só aceita depois dele."""
        if deletable(main, branch):
            return None, ""
        if ff and deletable(main, branch, ff["ff"]):
            return ff, ""
        return None, ("mas o `branch -d` recusaria (nem o upstream nem o HEAD de %s a contêm); atualize o clone "
                      "principal antes" % where)

    mine = {os.path.realpath(r) for r in roots}
    wts = worktrees(main)
    trancadas = locked(main)
    for path, branch in wts:
        if not branch or not can_leave(main, branch, base) or not os.path.isdir(path):
            continue
        # Nunca força: suja, trancada ou com `branch -d` recusando, a worktree fica e o motivo sai.
        if path in trancadas:
            fora.append("%s: [%s] já está em %s, mas está trancada (`git worktree lock`); não removo" % (tilde(path), branch, base))
            continue
        if not is_clean(path):
            fora.append("%s: [%s] já está em %s, mas tem arquivo sujo ou novo; não removo" % (tilde(path), branch, base))
            continue
        dep, nao = after_ff(branch)
        if nao:
            fora.append("%s: [%s] já está em %s, %s" % (tilde(path), branch, base, nao))
            continue
        cmd = "git -C %s worktree remove %s && git -C %s branch -d %s" % (
            shpath(main), shpath(path), shpath(main), shlex.quote(branch))
        antes = "depende do fast-forward (\0), sem o qual o `branch -d` recusaria: " if dep else ""
        junto = apaga_junto(path)
        if os.path.realpath(path) in mine:
            items.append(item(cmd, "%sworktree [%s] desta sessão já está em %s e está limpa%s; vai por último "
                              "porque removê-la tira o cwd do Bash" % (antes, branch, base, junto), last=True, dep=dep))
        else:
            items.append(item(cmd, "%sworktree [%s] de outra sessão já está em %s e está limpa%s"
                              % (antes, branch, base, junto), dep=dep))
    # Fora de worktree: nem checada em worktree nenhuma, nem o HEAD do clone, nem a padrão (`origin/main` → `main`).
    checked = {b for _, b in wts if b}
    _, heads = git(main, "rev-parse", "--abbrev-ref", "HEAD")
    _, refs = git(main, "for-each-ref", "--format=%(refname:short)", "refs/heads")
    for b in refs.split("\n"):
        if not b or b in checked or b == heads or b == base.split("/", 1)[-1] or not can_leave(main, b, base):
            continue
        dep, nao = after_ff(b)
        if nao:
            fora.append("%s: [%s] já está em %s, %s" % (where, b, base, nao))
            continue
        antes = "depende do fast-forward (\0), sem o qual o `branch -d` recusaria: " if dep else ""
        items.append(item("git -C %s branch -d %s" % (shpath(main), shlex.quote(b)),
                          "%sbranch local [%s] fora de worktree já está em %s" % (antes, b, base), dep=dep))
    return items, fora


# Os nomes que o docker cria sozinho e não deixa remover.
REDES_DO_DOCKER = ("bridge", "host", "none")


def plan_docker():
    """(itens, fora) das redes do docker sem container nenhum, nem parado: `docker network rm`, sem prune nem --force.
    O container parado conta: removida a rede, ele não sobe mais. Sem o docker na máquina, nada."""
    if not shutil.which("docker"):
        return [], []
    rc, redes = run(["docker", "network", "ls", "--format", "{{.Name}}"], timeout=15)
    rc2, usadas = run(["docker", "ps", "--all", "--no-trunc", "--format", "{{.Networks}}"], timeout=15)
    if rc or rc2:
        return [], ["docker: não consultei as redes (o docker não respondeu)"]
    usadas = {n for l in usadas.split("\n") for n in l.split(",") if n}
    vazias = [n for n in redes.split("\n") if n and n not in REDES_DO_DOCKER and n not in usadas]
    if not vazias:
        return [], []
    return [item("docker network rm %s" % " ".join(shlex.quote(n) for n in vazias),
                 "%s sem container nenhum, nem parado" % plural(len(vazias), "rede do docker", "redes do docker"))], []


# Sob agents/, por exclusão: o que o pull atualiza sozinho é o que o setup liga por symlink; o resto ele
# mescla ou registra (`~/dotfiles/.claude/rules/agents.md` diz qual é qual). Lista dos insumos de merge
# falharia calada no próximo que alguém criar; o erro da exclusão é um setup a mais, que aparece.
AGENTS_LINKED = ("agents/skills/*", "agents/instructions/*", "agents/tests/*")


def agents_merged(path):
    """O arquivo é de agents/ e o pull sozinho não o leva ao destino?"""
    if not path.startswith("agents/") or path.endswith(".md"):
        return False
    if any(fnmatch.fnmatchcase(path, g) for g in AGENTS_LINKED):
        return False
    return not path.startswith("agents/travas/") or path == "agents/travas/travas.json"


def setup_reason(changes):
    """Por que o diff pede ./setup.sh ('' se não pede). `changes`: (status, caminho) sem detecção de renomeação."""
    for st, path in changes:
        if st[:1] == "A":
            return "o diff traz arquivo novo (%s)" % path
        if st[:1] == "D":
            return "o diff remove arquivo (%s)" % path
        if path == "setup.sh" or fnmatch.fnmatchcase(path, "*/hooks/*"):
            return "o diff mexe em %s" % path
        if agents_merged(path):
            return "o diff mexe em %s, que o setup mescla ou registra em vez de linkar" % path
    return ""


def local_diff(root, head, up, ff=False):
    """(mudanças, None) do diff `head..up` lido no clone local, ou (None, porquê) quando não dá para saber.
    `ff`: `up` é o que um push vai publicar, e o pull só avança em fast-forward se `head` está no histórico dele."""
    if not head or not up:
        return None, "o host não devolveu os shas do HEAD e do upstream"
    for sha in (head, up):
        if git(root, "cat-file", "-e", sha + "^{commit}")[0] != 0:
            return None, "o commit %s do host não existe no clone local" % sha[:10]
    if ff and git(root, "merge-base", "--is-ancestor", head, up)[0] != 0:
        return None, "o HEAD do host não está no histórico do que o push publica"
    rc, out = git(root, "diff", "--name-status", "--no-renames", "-z", head, up)
    if rc != 0:
        return None, "o git diff falhou"
    parts = out.split("\0")
    return list(zip(parts[0::2], parts[1::2])), None


def decide_host(alias, fact, diff, push=None):
    """(itens, fora) do ~/dotfiles de um host. Pura: não toca disco nem rede.

    `fact`: dict com alvo (o nome que respondeu no ssh), behind, ahead e dirty (None quando
    o host não soube dizer), ou None se o ssh não respondeu. `diff()`: (mudanças, porquê-não).
    `push`: o item de push que deixa este host atrás do origin. Com ele o host conta como atrás do que o
    push leva, e o pull (e, por ele, o setup) só roda se o push rodou sem erro.
    """
    if fact is None:
        return [], ["%s: ssh não respondeu; não sei se o ~/dotfiles de lá está atrás" % alias]
    alvo = fact["alvo"]
    where = "%s:~/dotfiles" % alvo
    behind, ahead, dirty = fact["behind"], fact["ahead"], fact["dirty"]
    if behind is None or ahead is None:
        return [], ["%s: sem upstream ou em HEAD destacado; não proponho o pull" % where]
    why = []
    if ahead:
        why.append("%s à frente do origin" % plural(ahead, "commit", "commits"))
    if dirty is None:
        why.append("não sei se tem arquivo sujo")
    elif dirty:
        why.append("%d arquivo(s) sem commit" % dirty)
    if why:
        if behind:
            why.append("está %s atrás, mas não proponho o pull" % plural(behind, "commit", "commits"))
        return [], ["%s: %s" % (where, "; ".join(why))]
    after = behind + (push["push"]["ahead"] if push else 0)
    if not after:
        return [], []
    cmd = "ssh %s 'git -C ~/dotfiles pull --ff-only'" % shlex.quote(alvo)
    commits = plural(after, "commit", "commits")
    if push:
        pull = item(cmd, "depende do push (\0): %s ficará %s atrás do origin, sem commit à frente e sem arquivo sujo"
                    % (where, commits), dep=push)
    else:
        pull = item(cmd, "%s está %s atrás do origin, sem commit à frente e sem arquivo sujo" % (where, commits))
    changes, nao = diff()
    if changes is None:
        if push:
            return [], ["%s: depois do push, não sei se o pull avança em fast-forward (%s); "
                        "não proponho o pull nem o setup" % (where, nao)]
        return [pull], ["%s: não sei se precisa de ./setup.sh (%s); não proponho o setup" % (where, nao)]
    reason = setup_reason(changes)
    if not reason:
        return [pull], []
    setup = item("ssh %s 'cd ~/dotfiles && ./setup.sh'" % shlex.quote(alvo),
                 "depende do pull (\0): %s; pode recompilar a TUI com cargo, o que leva minutos: rodar em background"
                 % reason, dep=pull)
    return [pull, setup], []


def plan_hosts(net, slugs, facts, slug_root, pushes=()):
    """(itens, fora) dos outros hosts; só o ~/dotfiles vira item, os outros clones ficam só informados.

    `pushes`: os itens de push do plano. O host que segue a branch que um deles publica ficará atrás depois
    dele, e o diff do setup é então `HEAD do host..HEAD local`, não o do upstream do host (que é o de antes)."""
    hosts = other_hosts()
    if hosts is None:
        return [], [falta_vinculos("quais são as outras máquinas")]
    items, fora = [], []
    for alias, *_ in hosts:
        if not (net and slugs):
            fora.append("%s: não consultei (%s)" % (alias, "--sem-rede" if not net else "nenhum repo tocado tem remoto no GitHub"))
            continue
        mine = [f for f in facts if f["alias"] == alias]
        if any(f.get("mudo") for f in mine):
            fact = None
        else:
            dots = [f for f in mine if f["path"] == f["home"] + "/dotfiles"]
            if not dots:
                continue
            fact = dots[0]
        push = None if fact is None else next(
            (p for p in pushes if p["push"]["main"] == slug_root.get(fact["slug"])
             and p["push"]["upstream"] == fact.get("upname")), None)
        diff = None if fact is None else (lambda f=fact, p=push: local_diff(
            slug_root[f["slug"]], f["head"], p["push"]["head"] if p else f["up"], ff=bool(p)))
        i, f = decide_host(alias, fact, diff, push)
        items += i
        fora += f
    return items, fora


def render_plan(items, fora):
    """Linhas da seção: a worktree da sessão por último, o resto na ordem em que veio."""
    ordered = [i for i in items if not i["last"]] + [i for i in items if i["last"]]
    number = {id(it): n for n, it in enumerate(ordered, 1)}
    lines = []
    for n, it in enumerate(ordered, 1):
        why = it["why"].replace("\0", "P%d" % number[id(it["dep"])]) if it["dep"] else it["why"]
        lines.append("P%d. %s — %s" % (n, it["cmd"], why))
    return (lines or ["(nada a propor)"]) + ["- fora do plano: %s" % f for f in fora]


def task_info(path):
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    status = re.search(r"^> \[!(\w+)\]", text, re.M)
    desc = re.search(r"^> _(.*)_\s*$", text, re.M)
    return {
        "status": status.group(1) if status else "?",
        "desc": desc.group(1) if desc else "",
        "abertos": len(OPEN_ITEM.findall(text)),
    }


def all_tasks():
    active = glob.glob(os.path.join(VAULT, "projects", "*", "tasks", "*.md"))
    archived = glob.glob(os.path.join(VAULT, "projects", "*", "tasks", "archived", "*", "*.md"))
    return active, archived


def session_tasks(toques, active, archived):
    """Caminho atual de cada task que a sessão escreveu, os ids que sumiram e os outros arquivos."""
    by_id = {}
    for path in active + archived:
        by_id.setdefault(os.path.basename(path)[:-3], []).append(path)
    ids, files = [], []
    for entry in toques:
        kind, _, rest = entry.partition(" ")
        m = TASK_PATH.match(rest) if kind == "arquivo" else None
        if kind == "task":
            ids.append(rest)
        elif m:
            ids.append(m.group(2))
        elif kind == "arquivo":
            files.append(rest)
    ids = list(dict.fromkeys(ids))
    paths = sorted({p for i in ids for p in by_id.get(i, [])})
    missing = [i for i in ids if i not in by_id]
    return paths, missing, list(dict.fromkeys(files))


def describe_task(path):
    rel = os.path.relpath(path, os.path.join(VAULT, "projects"))
    parts = rel.split(os.sep)
    info = task_info(path)
    archived = parts[2] == "archived"
    where = "arquivada (%s)" % parts[3] if archived else info["status"]
    flag = ""
    if info["abertos"]:
        flag = " — %d item(ns) aberto(s)%s" % (info["abertos"], ", ENTERRADO em archived/" if archived else "")
    lines = ["  %s `%s` [%s]%s" % (parts[0], os.path.basename(path)[:-3], where, flag)]
    if info["desc"]:
        lines.append("      _%s_" % info["desc"])
    return lines


def report_vault(since, toques, tasks, mine, missing, files):
    lines = []
    conflicts = glob.glob(os.path.join(VAULT, "**", "*.sync-conflict-*"), recursive=True)
    lines.append("sync-conflict: %d%s" % (len(conflicts), " — não resolver sozinho" if conflicts else ""))
    lines += ["  %s" % os.path.relpath(c, VAULT) for c in conflicts[:10]]
    active, archived = tasks
    window = time.strftime("%d/%m %H:%M", time.localtime(since))
    touched = sorted(p for p in active + archived if os.path.getmtime(p) >= since)
    if toques is None:
        # Sem sessão (Cursor), não há como separar: vai tudo, como antes da ADR 0039.
        lines.append("tasks desta sessão: não sei (sem --sessao); mexidas na janela (%s em diante): %d"
                     % (window, len(touched)))
        for path in touched:
            lines += describe_task(path)
        return lines
    lines.append("tasks desta sessão: %d" % len(mine))
    for path in mine:
        lines += describe_task(path)
    lines += ["  `%s` — não existe mais (renomeada ou apagada)" % i for i in missing]
    if files:
        lines.append("outros arquivos do vault escritos pela sessão: %d" % len(files))
        lines += ["  %s" % f for f in files[:10]] + (["  …"] if len(files) > 10 else [])
    others = [p for p in touched if p not in mine]
    if others:
        lines.append("+%s por outras sessões na janela (%s em diante)"
                     % (plural(len(others), "task mexida", "tasks mexidas"), window))
    for path in others:
        if os.sep + "archived" + os.sep in path and task_info(path)["abertos"]:
            lines += describe_task(path)
    return lines


def contract_projects(root):
    """Projetos que o contrato do repo alimenta."""
    rows = vinculos("repo", root, cols=2)
    return set(rows[0][1].split()) if rows else set()


def report_registro(projects):
    falta = sem_vinculos("que projetos o contrato de cada repo alimenta")
    if not projects:
        return falta + ["nenhum projeto identificado"]
    if not os.access(COLETOR, os.X_OK):
        return falta + ["não consultei (coletor da current-project-state ausente)"]
    lines = falta
    for p in sorted(projects):
        rc, out = run([COLETOR, p, "--sem-rede", "--json"], timeout=60)
        try:
            reg = json.loads(out)["registro"] if rc == 0 else None
        except (ValueError, KeyError):
            reg = None
        if reg is None:
            lines.append("### %s: não consultei (o coletor saiu %d)" % (p, rc))
            continue
        if not reg.get("existe"):
            lines.append("### %s: sem registro nesta máquina (%s)" % (p, reg.get("caminho", "")))
            continue
        lines.append("### %s (%s)" % (p, reg["caminho"]))
        for label, key in (("decidido na conversa", "decidido"), ("adiado de propósito", "adiado")):
            body = [l for l in (reg.get(key) or "").split("\n") if l.strip()]
            lines.append("%s:%s" % (label, "" if body else " nada"))
            lines += ["  " + l for l in body]
    return lines


def pr_states(s, branch):
    """(número, estado) de cada PR da branch no repo, aberta, fechada ou mergeada; None quando o gh falha."""
    rc, out = run(["gh", "pr", "list", "--repo", s, "--head", branch, "--state", "all", "--limit", "100",
                   "--json", "number,state"], timeout=25)
    try:
        return [(p["number"], p["state"]) for p in json.loads(out or "[]")] if rc == 0 else None
    except (ValueError, KeyError, TypeError):
        return None


def report_arquivar(projects, active, net):
    """Linhas de `## arquivar sem perguntar`: a task em `question` dos projetos tocados, de qualquer sessão, sem
    `- [ ]` aberto, cuja branch `<id>` tem PR mergeada e nenhuma aberta nos repos vinculados ao projeto."""
    if not net:
        return ["não consultei (--sem-rede)"]
    tasks = []
    for path in active:
        m = TASK_PATH.match(os.path.relpath(path, VAULT))
        info = task_info(path)
        if m and m.group(1) in projects and info["status"] == "question" and not info["abertos"]:
            tasks.append(m.groups())
    if not tasks:
        return ["nada"]
    falta = sem_vinculos("que repos cada projeto tem")
    if falta:
        return falta
    slugs = {p: [s for s in (slug(clone) for _, clone, _ in vinculos("repos", p, cols=3) or []) if s]
             for p in {p for p, _ in tasks}}
    pares = [(t, s) for p, t in tasks for s in slugs[p]]
    # Uma chamada por branch e repo, que `--head` não aceita lista: em paralelo, para não somar segundos.
    with ThreadPoolExecutor(max_workers=8) as ex:
        found = dict(zip(pares, ex.map(lambda par: pr_states(par[1], par[0]), pares)))
    lines = []
    for p, t in sorted(tasks):
        falhou = [s for s in slugs[p] if found[(t, s)] is None]
        if falhou:
            lines.append("%s `%s`: não consultei as PRs em %s (gh falhou); não arquive" % (p, t, ", ".join(falhou)))
            continue
        prs = [(s, n, st) for s in slugs[p] for n, st in found[(t, s)]]
        mergeadas = ["#%d em %s" % (n, s) for s, n, st in prs if st == "MERGED"]
        if mergeadas and not any(st == "OPEN" for _, _, st in prs):
            lines.append("%s `%s`: PR %s mergeada, nenhuma aberta, nenhum `- [ ]`" % (p, t, ", ".join(mergeadas)))
    return lines or ["nada"]


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    # Sem valor quando o agente não substitui ${CLAUDE_SESSION_ID} (Cursor).
    ap.add_argument("--sessao", nargs="?", const="", default="")
    ap.add_argument("--repo", action="append", default=[])
    ap.add_argument("--horas", type=float)
    ap.add_argument("--sem-rede", action="store_true")
    ap.add_argument("--plano", action="store_true",
                    help="acrescenta `## plano`: os comandos de push, fast-forward, limpeza e pull, só impressos")
    a = ap.parse_args()
    # Nome de arquivo que não é UTF-8 sai como veio, em qualquer locale.
    sys.stdout.reconfigure(errors="surrogateescape")
    net = not a.sem_rede

    lists = session_lists(a.sessao)
    roots = list(lists)
    for d in [os.getcwd()] + a.repo:
        r = repo_root(os.path.expanduser(d))
        if r:
            roots.append(r)
    roots = list(dict.fromkeys(r for r in roots if r and os.path.isdir(r)))
    clones = {root: main_clone(root) for root in roots}
    groups = {}
    for root in roots:
        groups.setdefault(clones[root] or root, []).append(root)

    toques = vault_toques(a.sessao)
    active, archived = all_tasks()
    mine, missing, files = session_tasks(toques or [], active, archived)
    # A janela só serve ao que é de outra sessão; o da sessão vem das travas.
    since = time.time() - (a.horas if a.horas is not None else 12) * 3600

    print("## sessão")
    vault = ("não sei (sem --sessao)" if toques is None else
             "%s e %s escritos" % (plural(len(mine) + len(missing), "task", "tasks"),
                                  plural(len(files), "outro arquivo", "outros arquivos")))
    print("id %s · %s desta sessão · vault: %s" % (
        a.sessao or "(não informado)", plural(len(groups), "repo", "repos"), vault))
    print("\n## repos")
    # Sem resposta do vault-vinculos, um worktree conta como clone principal, e o
    # plano proporia remover o principal. Aí não há plano.
    sem_clone = None in clones.values()
    if sem_clone:
        print(falta_vinculos("o clone principal de cada worktree"))
    slugs, slug_root, itens, fora = [], {}, [], []
    for main_root, rs in groups.items():
        lines, s = report_repo(main_root, rs, {r: touched_files(r, lists, a.sessao) for r in rs}, net)
        print("\n".join(lines))
        if s and s not in slugs:
            slugs.append(s)
        if s:
            slug_root.setdefault(s, main_root)
        if a.plano and not sem_clone:
            i, f = plan_repo(main_root, rs, net)
            itens += i
            fora += f
    if not groups:
        print("nenhum repo identificado; passe --repo <dir>")
    print("\n## outras máquinas")
    facts = []
    print("\n".join(report_hosts(slugs, net, facts)))
    print("\n## vault")
    print("\n".join(report_vault(since, toques, (active, archived), mine, missing, files)))

    projects = {os.path.relpath(p, os.path.join(VAULT, "projects")).split(os.sep)[0] for p in mine}
    projects |= {f.split("/")[1] for f in files if f.startswith("projects/") and f.count("/") >= 2}
    for root in roots:
        projects |= contract_projects(root)
    # Sem resposta do vault-vinculos não há lista, e o filtro apagaria até os projetos das tasks tocadas.
    known = vinculos("projetos")
    if known is not None:
        projects &= {p for p, in known}
    print("\n## registro dos projetos (não reapresentar como ponta solta)")
    print("\n".join(report_registro(projects)))
    print("\n## arquivar sem perguntar")
    print("\n".join(report_arquivar(projects, active, net)))
    if a.plano:
        print("\n## plano")
        if sem_clone:
            print(falta_vinculos("o clone principal de cada worktree, e sem ele não proponho nada"))
            return
        d, g = plan_docker()
        i, f = plan_hosts(net, slugs, facts, slug_root, [it for it in itens if it["push"]])
        print("\n".join(render_plan(itens + d + i, fora + g + f)))


if __name__ == "__main__":
    main()
