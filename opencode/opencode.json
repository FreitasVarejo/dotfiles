{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "snapshot": true,
  "permission": {},
  "tools": {},
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "build/**",
      "coverage/**"
    ]
  },
  "mcp": {
    "docker": {
      "type": "local",
      "command": ["npx", "-y", "docker-mcp"],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-sqlite-npx", "${workspaceFolder}/data/metadata.db"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["npx", "-y", "git-mcp"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "obsidian": {
      "type": "local",
      "command": ["uvx", "mcp-obsidian"],
      "enabled": true
    }
  }
}
