# Gerenciado pelo repo dotfiles (pacote `ssh`).
#
# NÃO ponha host, IP ou usuário aqui: FreitasVarejo/dotfiles é PÚBLICO. O que
# identifica máquina vive em ~/.ssh/config.local, que não é versionado — mesma
# convenção de ~/.bashrc.local para estado por máquina.
#
# A ordem importa: no ssh_config vale o PRIMEIRO valor visto para cada keyword,
# então o Include vem antes do bloco `Host *` para que os hosts locais possam
# sobrescrever qualquer default daqui.
Include ~/.ssh/config.local

Host *
    # Multiplexação: a primeira conexão abre um socket master e as seguintes
    # viajam dentro dele, pulando handshake TCP + troca de chaves. Num link de
    # ~80 ms isso tira ~0,5 s de CADA conexão nova, e uma sessão de código abre
    # várias por minuto (git, LSP, scp, rsync).
    #
    # ControlPath usa %C (hash de host+porta+usuário) em vez de %r@%h:%p porque
    # socket unix tem limite de ~104 caracteres no path — com hostname longo o
    # formato legível estoura e a multiplexação falha em silêncio.
    ControlMaster auto
    ControlPath ~/.ssh/cm/%C
    ControlPersist 10m

    # Mantém a sessão viva atrás de NAT/Tailscale sem depender do keepalive do
    # TCP: 3 falhas seguidas (~60 s) derrubam a conexão em vez de deixar o
    # terminal congelado sem resposta.
    ServerAliveInterval 20
    ServerAliveCountMax 3

    # Compressão desligada de propósito. Ela troca banda por CPU, e o gargalo
    # aqui é CPU no lado servidor (Pi 5 de 4 núcleos rodando CI), não banda.
    Compression no
